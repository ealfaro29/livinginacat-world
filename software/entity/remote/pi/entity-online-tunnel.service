[Unit]
Description=Alfonsito outbound Cloudflare connection
Wants=network-online.target
After=network-online.target entity-online-origin.service

[Service]
DynamicUser=yes
LoadCredential=tunnel:/etc/entity-online/tunnel.token
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file %d/tunnel
Restart=always
RestartSec=6
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
