[Unit]
Description=Alfonsito private operator gateway
After=network.target

[Service]
DynamicUser=yes
LoadCredential=relay:/etc/entity-online/relay
ExecStart=/usr/bin/python3 /opt/entity-online/origin.py
Restart=always
RestartSec=4
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
